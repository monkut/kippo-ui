{
  "plugins": ["promise", "import", "node", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eslint/max-depth": ["error", { "max": 10 }],
    "eslint/max-lines-per-function": ["warn", { "max": 50 }],
    "eslint/max-nested-callbacks": ["error", { "max": 20 }],
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "*.min.js",
    "app/lib/api/generated"
  ]
}
